{
	"name": "sitesmith-studio",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file=.env scripts/migrate.mjs",
		"db:seed-owner": "node --env-file=.env scripts/seed-owner.ts",
		"db:seed-project": "node --env-file=.env scripts/seed-project.ts",
		"db:start": "node scripts/db.mjs start",
		"db:status": "node scripts/db.mjs status",
		"db:stop": "node scripts/db.mjs stop",
		"db:studio": "drizzle-kit studio",
		"dev": "next dev --turbo",
		"image:verify": "node scripts/verify-image.mjs",
		"preview": "next build && next start",
		"start": "next start",
		"test": "npm run test:unit && npm run test:integration",
		"test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:unit": "vitest run --config vitest.unit.config.ts",
		"test:watch": "vitest --config vitest.unit.config.ts",
		"typecheck": "tsc --noEmit",
		"vault:mirror": "node scripts/mirror-context-to-vault.mjs"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.7.2",
		"@t3-oss/env-nextjs": "^0.12.0",
		"@tanstack/react-query": "^5.69.0",
		"@trpc/client": "^11.0.0",
		"@trpc/react-query": "^11.0.0",
		"@trpc/server": "^11.0.0",
		"drizzle-orm": "^0.45.2",
		"next": "^16.3.1",
		"next-auth": "^5.0.0-beta.32",
		"pixelmatch": "^7.2.0",
		"playwright": "^1.62.1",
		"pngjs": "^7.0.0",
		"postgres": "^3.4.4",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"server-only": "^0.0.1",
		"superjson": "^2.2.1",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.0.15",
		"@types/node": "^20.14.10",
		"@types/pngjs": "^6.0.5",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"drizzle-kit": "^0.31.10",
		"postcss": "^8.5.3",
		"tailwindcss": "^4.0.15",
		"typescript": "^5.8.2",
		"vitest": "^4.1.11"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	},
	"packageManager": "npm@11.16.0",
	"engines": {
		"node": ">=22.18.0"
	}
}
